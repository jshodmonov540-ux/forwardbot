# Bot sozlamalari
BOT_TOKEN=your_bot_token_from_botfather
BOT_USERNAME=your_bot_username

# Telegram MTProto Userbot API (my.telegram.org saytidan olinadi)
API_ID=your_api_id
API_HASH=your_api_hash

# Ma'lumotlar bazasi (PostgreSQL tavsiya etiladi)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forwardbot
# DATABASE_URL=sqlite+aiosqlite:///./data/forwardbot.db

# Ixtiyoriy Redis
REDIS_URL=redis://localhost:6379/0

# Xavfsizlik sozlamalari
INVITE_CODE_REQUIRED=false
ADMIN_IDS=[123456789,987654321]

# Logging
LOG_LEVEL=INFO

# Webhook (ixtiyoriy)
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_super_secret_token
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
